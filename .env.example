# Copy this file to .env and fill in real values before running.

# Supabase: Connect -> Transaction pooler (port 6543). URL-encode the password.
# Keep this server-only. Prefer .env.local for real credentials.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres

# Used only by npm run seed to create/rotate event logins. No demo data added.
ADMIN_PASSWORD=
VOLUNTEER_PASSWORD=

# Any long random string — used to sign login session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

# Leave blank for local/dev (QR codes will just encode the raw token).
# Set to your real deployed domain (no trailing slash) in production, e.g.
# APP_BASE_URL=https://ganesh2026.yourdomain.com
# When set, QR codes encode https://<APP_BASE_URL>/verify/<token> instead.
APP_BASE_URL=

# Google Sheets Webhook secret — shared secret string checked by /api/participants/webhook.
# Must match the SHEETS_WEBHOOK_SECRET Script Property set in Google Apps Script.
SHEETS_WEBHOOK_SECRET=your_sheets_webhook_secret_here

# SMTP Email Configuration (Nodemailer)
# Default is Gmail SMTP. To generate a Gmail App Password:
# 1. Turn on 2-Step Verification in your Google Account (Security settings).
# 2. Go to Google Account -> Security -> App passwords.
# 3. Create a new App Password for "Mail", copy the 16-character password below into SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Ganesh Chaturthi 2026 Committee <your_email@gmail.com>"

# Optional WhatsApp Cloud API. Leave blank to use the wa.me fallback.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional template values used for {DATE} and {VENUE}.
EVENT_DATE=14th September 2026
EVENT_VENUE=Auditorium
